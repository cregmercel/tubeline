# Dependencies and build output
node_modules
dist
*.tsbuildinfo
coverage

# Foundry: compiler output and local-chain broadcasts. Broadcasts to real networks are kept: they are the
# record of what was deployed where.
contracts/out
contracts/cache
contracts/broadcast/*/31337/
contracts/broadcast/**/dry-run/

# Keys and local configuration. Never commit a private key.
.env
.env.*
!.env.example

# OS and editor clutter
.DS_Store
Thumbs.db
.idea
.vscode/*
!.vscode/extensions.json
*.swp

# Logs
*.log
npm-debug.log*
